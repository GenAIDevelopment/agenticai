{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MCP Server (uv)",
            "type": "debugpy",
            "request": "launch",
            "module": "mcp",
            "args": [
                "dev",
                "${workspaceFolder}/cafe_server.py"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "subProcess": true
        }
    ]
}